# Keys for `bun run bench`. Copy to `.env` (git-ignored) and fill in the ones
# you have; the bench runs every model whose provider key is set.

# TypeSafe: jev
TYPESAFE_API_KEY=

# Cloudflare Workers AI: clef, clef-flash (both values needed)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenAI: gpt-6-luna
OPENAI_API_KEY=

# OpenRouter: every OpenRouter model in DECISION_MODELS (microsoft/microsoft-decision-1, …)
OPENROUTER_API_KEY=
